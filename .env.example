# Copy to .env and fill in. Never commit .env.

# Public hostname (DuckDNS free subdomain), no scheme
MCP_DOMAIN=yourname.duckdns.org
DUCKDNS_TOKEN=

# Google OAuth client (Web application) — redirect URI: https://<MCP_DOMAIN>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The ONLY Google account allowed to use the MCP server
ALLOWED_EMAIL=you@gmail.com

# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=
# Generate with: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
STORAGE_ENCRYPTION_KEY=
# Shared with the Apps Script (script property WEBHOOK_SECRET)
WEBHOOK_SECRET=

# Write safety (applies to reply_to_conversation from Claude/Gemini and Telegram)
WRITE_COOLDOWN_SECONDS=60
WRITE_DAILY_CAP=20
# Tools exposed to Claude/Gemini (comma separated). Default = DM tools only.
# ALLOWED_TOOLS=get_inbox,get_conversation,search_conversations,reply_to_conversation,get_session_status

# Daily digest (local time)
DAILY_DIGEST_HOUR=18
DAILY_DIGEST_TZ=America/Los_Angeles

# Telegram (@BotFather token; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini API free tier (https://aistudio.google.com/apikey)
# Optional: only used to put AI-drafted replies inside Telegram alerts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
