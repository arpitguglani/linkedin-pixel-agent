{$MCP_DOMAIN} {
	encode gzip

	# Gmail Apps Script webhook -> watcher
	handle /webhook/* {
		reverse_proxy 127.0.0.1:8090
	}

	# MCP endpoint + OAuth endpoints (/.well-known/*, /authorize, /token,
	# /register, /auth/callback, /consent) -> auth proxy
	handle {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# LinkedIn login viewer (noVNC). Only answers while scripts/linkedin_login.sh is
# running (otherwise 502). Access additionally requires the random token that
# the script prints in the URL fragment.
login.{$MCP_DOMAIN} {
	reverse_proxy 127.0.0.1:6080
}
